{
  "name": "lumos",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Work Assistant for ServiceNow",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm build:swift && concurrently \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "pnpm build:swift && pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.main.json",
    "build:swift": "cd swift && swift build",
    "build:swift:release": "cd swift && swift build -c release",
    "test:swift": "cd swift && swift test",
    "test:audio-integration": "pnpm build:swift && pnpm build:main && cross-env NODE_ENV=development node --loader ts-node/esm scripts/test-audio-integration.ts",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "package": "electron-builder build --mac --publish never",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "LumenLab",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.5",
    "yaml": "^2.8.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.18",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.4.0",
    "electron-builder": "^26.6.0",
    "electron-updater": "^6.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.35",
    "postcss-nesting": "^12.1.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
